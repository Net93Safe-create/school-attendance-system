<?xml version="1.0" encoding="UTF-8"?>
<flowgorithm fileversion="2.18">
  <attributes>
    <attribute name="name" value="School Attendance System" />
    <attribute name="authors" value="Sulaiman Kondeh" />
    <attribute name="about" value="Programming Logic assignment prototype: record attendance and display totals." />
    <attribute name="saved" value="2026-10-14 13:47:00" />
    <attribute name="created" value="2026-10-14 13:47:00" />
  </attributes>
  <function name="Main" type="None" variable="">
    <parameters />
    <body>
      <output expression="&quot;SCHOOL ATTENDANCE SYSTEM&quot;" newline="True" />
      <declare name="className" type="String" array="False" size="" />
      <declare name="attendanceDate" type="String" array="False" size="" />
      <declare name="studentCount" type="Integer" array="False" size="" />
      <declare name="studentNumber" type="Integer" array="False" size="" />
      <declare name="studentName" type="String" array="False" size="" />
      <declare name="statusCode" type="String" array="False" size="" />
      <declare name="presentCount" type="Integer" array="False" size="" />
      <declare name="absentCount" type="Integer" array="False" size="" />
      <declare name="lateCount" type="Integer" array="False" size="" />
      <assign variable="presentCount" expression="0" />
      <assign variable="absentCount" expression="0" />
      <assign variable="lateCount" expression="0" />
      <output expression="&quot;Enter class name:&quot;" newline="True" />
      <input variable="className" />
      <output expression="&quot;Enter attendance date (YYYY-MM-DD):&quot;" newline="True" />
      <input variable="attendanceDate" />
      <output expression="&quot;Enter number of students (must be greater than 0):&quot;" newline="True" />
      <input variable="studentCount" />
      <while expression="studentCount &lt;= 0">
        <output expression="&quot;Invalid number. Enter a number greater than 0:&quot;" newline="True" />
        <input variable="studentCount" />
      </while>
      <assign variable="studentNumber" expression="1" />
      <while expression="studentNumber &lt;= studentCount">
        <output expression="&quot;Enter student name:&quot;" newline="True" />
        <input variable="studentName" />
        <output expression="&quot;Enter status: P = Present, A = Absent, L = Late&quot;" newline="True" />
        <input variable="statusCode" />
        <while expression="statusCode != &quot;P&quot; and statusCode != &quot;A&quot; and statusCode != &quot;L&quot;">
          <output expression="&quot;Invalid status. Enter P, A, or L:&quot;" newline="True" />
          <input variable="statusCode" />
        </while>
        <if expression="statusCode = &quot;P&quot;">
          <then>
            <assign variable="presentCount" expression="presentCount + 1" />
          </then>
          <else>
            <if expression="statusCode = &quot;A&quot;">
              <then>
                <assign variable="absentCount" expression="absentCount + 1" />
              </then>
              <else>
                <assign variable="lateCount" expression="lateCount + 1" />
              </else>
            </if>
          </else>
        </if>
        <assign variable="studentNumber" expression="studentNumber + 1" />
      </while>
      <output expression="&quot;ATTENDANCE SUMMARY&quot;" newline="True" />
      <output expression="&quot;Class: &quot; &amp; className" newline="True" />
      <output expression="&quot;Date: &quot; &amp; attendanceDate" newline="True" />
      <output expression="&quot;Total students: &quot; &amp; studentCount" newline="True" />
      <output expression="&quot;Present: &quot; &amp; presentCount" newline="True" />
      <output expression="&quot;Absent: &quot; &amp; absentCount" newline="True" />
      <output expression="&quot;Late: &quot; &amp; lateCount" newline="True" />
      <output expression="&quot;Prototype finished. Records are summarized for this run; they are not saved to a database.&quot;" newline="True" />
    </body>
  </function>
</flowgorithm>
